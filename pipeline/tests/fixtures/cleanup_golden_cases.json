    {"name": "london_uk",           "input": "London, UK",          "expected": {"city": "London", "state": null, "country": "United Kingdom"}},
    {"name": "california_state_only","input": "California",          "expected": {"city": null, "state": "California", "country": "United States"}},
    {"name": "atlantis_unknown",     "input": "Atlantis",            "expected": {"city": "Atlantis", "state": null, "country": null}},
    {"name": "cache_hit",
     "input": "San Francisco, CA",
     "preload": {"San Francisco, CA": {"city": "FakeCity", "state": "FakeState", "country": "FakeCountry"}},
     "expected": {"city": "FakeCity", "state": "FakeState", "country": "FakeCountry"}}
