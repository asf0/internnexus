# Database configuration (required)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
PIPELINE_DB_POOL_SIZE=2
PIPELINE_DB_MAX_OVERFLOW=2
# PgBouncer-compat fallback: unset by default (MAX_PREPARED_STATEMENTS=200
# on the pgbouncer service already handles asyncpg's prepared statements).
# Set to 0 to disable asyncpg's statement cache if a PgBouncer without
# max_prepared_statements support is ever used.
DB_STATEMENT_CACHE_SIZE=
# Transaction-mode pgbouncer pool size (backend/mcp only; pipeline and
# migrate bypass pgbouncer and connect directly to `db`).
PGBOUNCER_DEFAULT_POOL_SIZE=10

# OpenAI-compatible inference API
OPENAI_BASE_URL=http://192.168.0.4:8080/v1
# Set only when classification uses a different OpenAI-compatible endpoint.
OPENAI_CLASSIFICATION_URL=
EMBEDDING_MODEL=qwen3-embedding-4b
EMBEDDING_DIMENSIONS=1024
# Per-request embedding timeout. Raise for slow self-hosted endpoints: a full
# api_batch_size request against a swapping/CPU-bound model can exceed a minute.
EMBEDDING_TIMEOUT_SECONDS=180
CLASSIFICATION_MODEL=
CLASSIFICATION_BATCH_SIZE=10
CLASSIFICATION_MAX_CONCURRENT=4

# Cloudflare tunnel token
CLOUDFLARED_TOKEN=

# Redis configuration (optional; leave empty for in-memory cache)
REDIS_URL=

# Authentication and secret configuration
AUTH_SECRET=

# OAuth credentials (Google and GitHub sign-in)
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API URLs
GREENHOUSE_API_URL=
LEVER_API_URL=
ASHBY_API_URL=
SIMPLIFY_JOBS_INTERN_URL=
SIMPLIFY_JOBS_NEW_GRAD_URL=

# Backend and frontend URLs
BACKEND_URL=
# Private service address and shared secret for job-detail cache invalidation.
# Generate the secret with: openssl rand -hex 32
FRONTEND_INTERNAL_URL=http://frontend:3000
JOB_CACHE_REVALIDATION_SECRET=
# Disabled by default; benchmark counters are served only to authenticated
# loopback callers at /internal/bench/job-detail-counters.
BENCHMARK_COUNTERS_ENABLED=false
BENCHMARK_COUNTERS_SECRET=
# Public MCP origin. Production deployments must use HTTPS.
MCP_PUBLIC_URL=http://localhost:8001

NEXTAUTH_URL=
AUTH_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_CREDENTIAL_AUTH=true
NEXT_PUBLIC_API_URL=

# CORS origins
CORS_ORIGINS=

# Proxy trust settings
# Set TRUST_PROXY_HEADERS=true only if traffic always comes through your proxy.
# Set TRUSTED_PROXY_IPS to a comma-separated list of IPs or CIDRs.
TRUST_PROXY_HEADERS=
TRUSTED_PROXY_IPS=

# Required in production: dedicated resume PII encryption key (Fernet key,
# base64-encoded 32-byte). New ciphertexts never use AUTH_SECRET.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESUME_ENCRYPTION_KEY=

# Optional: dedicated HMAC key for pseudonymizing client IPs in click analytics.
# Falls back to AUTH_SECRET when unset. Set a separate value to decouple IP-hash
# correlation from JWT-secret rotation. Generate with `openssl rand -hex 32`.
IP_HASH_SECRET=

# Set to true to skip production pipeline runs. The future GitHub Actions
# pipeline workflow will read this from /opt/internjobs/production.env.
PIPELINE_MAINTENANCE_MODE=false

# Memory-conscious production profile. `shared_buffers` is the primary
# resident-memory allocation; `effective_cache_size` is only a planner estimate.
# Tune upward only after measuring real production usage and query latency.
DB_MEMORY_LIMIT=2g
DB_CPU_LIMIT=2.0
DB_SHM_SIZE=512mb
PGBOUNCER_MEMORY_LIMIT=64m
PGBOUNCER_CPU_LIMIT=0.5
POSTGRES_SHARED_BUFFERS=512MB
# SSD-oriented planner/IO settings for the memory-conscious profile.
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_MIN_WAL_SIZE=512MB
# Local/self-hosted durability trade-off: commit returns before WAL is flushed.
# A crash can lose the last few hundred ms of committed transactions, but
# cannot corrupt the database. Set to `on` if you need strict durability.
POSTGRES_SYNCHRONOUS_COMMIT=off
BACKEND_MEMORY_LIMIT=512m
BACKEND_CPU_LIMIT=1.0
PIPELINE_MEMORY_LIMIT=1g
PIPELINE_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=1.0
CLOUDFLARED_MEMORY_LIMIT=128m
CLOUDFLARED_CPU_LIMIT=0.5
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
